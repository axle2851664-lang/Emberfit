# ---------------------------------------------------------------------------
# EmberFit environment
# Copy to .env and fill in what you have. The app runs fully without any keys:
# every external service has a local fallback.
# ---------------------------------------------------------------------------

# SQLite by default. Point at Postgres and change prisma/schema.prisma's
# datasource provider to switch.
DATABASE_URL="file:./dev.db"

# Optional. Enables AI food-photo recognition. Server-side only — this value is
# never sent to the browser. Without it the photo flow falls back to manual
# ingredient entry.
ANTHROPIC_API_KEY=""
ANTHROPIC_VISION_MODEL="claude-opus-5"

# Optional. Open Food Facts needs no key but asks for an identifying UA string.
OPEN_FOOD_FACTS_USER_AGENT="EmberFit/1.0 (self-hosted)"

# Optional. Set to "0" to keep the app fully offline (local food table only).
ENABLE_REMOTE_FOOD_LOOKUP="1"
