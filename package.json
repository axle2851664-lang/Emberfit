{
  "name": "emberfit",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "prisma generate && node scripts/next.mjs build",
    "start": "node scripts/next.mjs start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push && npm run db:seed",
    "test": "tsx --test tests/selftest.ts",
    "ensure-env": "node scripts/ensure-env.mjs",
    "predev": "node scripts/ensure-env.mjs && node scripts/ensure-db.mjs",
    "prebuild": "node scripts/ensure-env.mjs",
    "presetup": "node scripts/ensure-env.mjs",
    "prestart": "node scripts/ensure-env.mjs && node scripts/ensure-db.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "framer-motion": "^11.15.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "zxing-wasm": "^1.2.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.63.0",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
